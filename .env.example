# Copy to .env and edit. Never commit .env. Placeholder values only in this file.
# No API key is needed anywhere: VentureGate uses a local open-weight model only.

MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434

# live = call the local model; replay = replay a recorded real run
RUN_MODE=live
LLM_TIMEOUT=900
NUM_CTX=8192

DECISION_LOG=decision_log.json
OUTPUT_DIR=outputs
EVIDENCE_LEDGER=outputs/evidence_ledger.json
SOURCES_DIR=sources
REPLAY_DIR=replay
STATE_DIR=.state

# Evidence: Steve searches the web live (free, no API key). Set to false to use only pages saved in sources/.
WEB_SEARCH=true
SEARCH_RESULTS_PER_QUERY=4
# Optional: your own SearXNG instance (open-source meta-search), e.g. http://localhost:8080
SEARXNG_URL=
